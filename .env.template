# ── LangChain tracing (optional) ──────────────────────────
LANGCHAIN_API_KEY=paste your langchain key here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=first-llm-app

# ── Ollama ─────────────────────────────────────────────────
OLLAMA_MODEL=llama3
EMBED_MODEL=nomic-embed-text
TEMPERATURE=0.3
NUM_PREDICT=200

# ── Document processing ────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ── Retrieval ──────────────────────────────────────────────
TOP_K=5

# ── Session management ─────────────────────────────────────
SESSION_TTL_HOURS=24

# ── Upload limits ──────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ── CORS (comma-separated origins) ────────────────────────
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

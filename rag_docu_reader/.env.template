# ── SaaS Backend Config ────────────────────────────────
DATABASE_URL=postgresql://user:password@hostname:5432/dbname
SECRET_KEY=your-random-secret-key-here
REDIS_URL=rediss://default:password@hostname:port

# ── Storage Config (Supabase S3) ───────────────────────
S3_ENDPOINT_URL=https://your-project.supabase.co/storage/v1/s3
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=doctalk-storage

# ── Groq LLM ───────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.3
MAX_TOKENS=1024

# ── LangChain Tracing ──────────────────────────────────
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=first-llm-app

# ── Document processing ──────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_FILE_SIZE_MB=10

# ── Retrieval ────────────────────────────────────────
TOP_K=5
EMBED_MODEL=all-MiniLM-L6-v2

# ── Session management ───────────────────────────────
SESSION_TTL_HOURS=24

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
